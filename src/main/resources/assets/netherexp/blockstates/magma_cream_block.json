{
  "multipart": [
    {
      "apply": {
        "model": "netherexp:block/magma_cream_block/sticky"
      }
    },
    {
      "apply": {
        "model": "netherexp:block/magma_cream_block/slick_north"
      },
      "when": {
        "north": "true"
      }
    },
    {
      "apply": {
        "model": "netherexp:block/magma_cream_block/slick_east"
      },
      "when": {
        "east": "true"
      }
    },
    {
      "apply": {
        "model": "netherexp:block/magma_cream_block/slick_south"
      },
      "when": {
        "south": "true"
      }
    },
    {
      "apply": {
        "model": "netherexp:block/magma_cream_block/slick_west"
      },
      "when": {
        "west": "true"
      }
    },
    {
      "apply": {
        "model": "netherexp:block/magma_cream_block/slick_up"
      },
      "when": {
        "up": "true"
      }
    },
    {
      "apply": {
        "model": "netherexp:block/magma_cream_block/slick_down"
      },
      "when": {
        "down": "true"
      }
    }
  ]
